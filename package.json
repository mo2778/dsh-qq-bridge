{
  "name": "dsh-qq-bridge",
  "version": "1.0.4",
  "description": "DSH <-> QQ bridge over OneBot 11 HTTP (NapCat / SnowLuma). Fork with WebSocket push, per-id dedupe and silent-drop logging.",
  "license": "MIT",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "tools"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mo2778/dsh-qq-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/mo2778/dsh-qq-bridge/issues"
  },
  "homepage": "https://github.com/mo2778/dsh-qq-bridge#readme",
  "author": "Yuuyuko-uu",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin"
  ]
}
